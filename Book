import java.util.Objects;

public class Book {
    private final String isbn;
    private final String BookName;
    private final Author Author;
    private final Genre Genre;
    private final Bookshelf bookshelf;

    public Book(String isbon,String BookName,Author Author,Genre Genre,Bookshelf bookshelf){
        this.isbn = isbon;
        this.BookName = BookName;
        this.Author = Author;
        this.Genre = Genre;
        this.bookshelf = bookshelf;
    }

    public String getBookName() {
        return BookName;
    }

    @Override
    public boolean equals(Object o) {
        if (this == o) return true;
        if (!(o instanceof Book)) return false;
        Book other = (Book) o;
        return Objects.equals(isbn, other.isbn);
    }

    public String getLocationAddress() {
        return bookshelf != null ? bookshelf.getFullAddress() : "не размещён";
    }

    @Override
    public int hashCode() {
        return Objects.hashCode(isbn);
    }

    @Override
    public String toString() {
        return"\"" + BookName + "\" - " + Author +" (" + Genre + ", ISBN: " + isbn + ")\nРасположение: " + getLocationAddress();
    }

}
